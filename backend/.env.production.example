APP_ENV=production
APP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=sqlite+aiosqlite:////data/adpathlens.db
REPORT_STORAGE_PATH=/data/reports
LOCAL_MODE=false
DEMO_MODE=false
E2E_MODE=false
SESSION_COOKIE_SECURE=true
