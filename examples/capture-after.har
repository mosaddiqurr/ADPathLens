{
  "log": {
    "version": "1.2",
    "creator": {"name": "AuthZDiff fictional example", "version": "1.0"},
    "entries": [
      {
        "_authzdiff": {"principal": "Alice", "access": "allowed", "sensitive": true},
        "request": {"method": "GET", "url": "https://example.invalid/reports", "headers": []},
        "response": {"status": 200, "headers": [], "content": {"mimeType": "application/json", "text": "{\"report\":\"fictional\"}"}}
      },
      {
        "_authzdiff": {"principal": "Bob", "access": "denied"},
        "request": {"method": "GET", "url": "https://example.invalid/billing", "headers": []},
        "response": {"status": 403, "headers": [], "content": {"mimeType": "application/json", "text": "{\"error\":\"forbidden\"}"}}
      }
    ]
  }
}
