APP_ENV=development
APP_NAME=ADPathLens
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite+aiosqlite:///./adpathlens-local.db
SESSION_COOKIE_NAME=adpathlens_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_EXPIRY_MINUTES=480
ALLOWED_FRONTEND_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173
MAX_UPLOAD_BYTES=52428800
MAX_ARCHIVE_ENTRIES=100
MAX_UNCOMPRESSED_BYTES=209715200
MAX_JSON_DEPTH=20
MAX_CSV_ROWS=125000
MAX_GRAPH_NODES=25000
MAX_GRAPH_RELATIONSHIPS=100000
MAX_PATH_DEPTH=12
MAX_RETURNED_PATHS=25
GRAPH_CACHE_TTL_SECONDS=300
REPORT_STORAGE_PATH=./reports
LOG_LEVEL=INFO
DEMO_MODE=true
LOCAL_MODE=true
E2E_MODE=false
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:8011
MAX_ANALYSIS_EXPANSIONS=100000
ANALYSIS_DEADLINE_SECONDS=5
