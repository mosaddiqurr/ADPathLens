APP_ENV=development
APP_NAME=AuthZDiff
APP_VERSION=1.0.0-rc1
APP_SECRET_KEY=replace-with-a-base64-encoded-32-byte-key
FIRST_ADMIN_SETUP_TOKEN=replace-with-a-random-setup-token
APPLICATION_URL=http://localhost:8020
FRONTEND_URL=http://localhost:4174
SESSION_COOKIE_NAME=authzdiff_session
SESSION_COOKIE_SECURE=false
SESSION_EXPIRY_MINUTES=480
DATABASE_URL=sqlite+aiosqlite:///./authzdiff.db
ENCRYPTION_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
ENCRYPTION_OLD_KEYS=
ALLOWED_FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1
MAX_HAR_UPLOAD_BYTES=10485760
MAX_REQUEST_BODY_BYTES=1048576
MAX_RESPONSE_BYTES=2097152
MAX_REPORT_EXCERPT_BYTES=102400
DEFAULT_REQUEST_TIMEOUT_SECONDS=10
MAX_REDIRECTS=3
MAX_DECOMPRESSION_RATIO=100
REPLAY_EXECUTION_MODE=external
REPLAY_GLOBAL_CONCURRENCY=5
REPLAY_WORKER_POLL_MS=250
REPLAY_WORKER_HEARTBEAT_SECONDS=5
REPLAY_STALE_AFTER_SECONDS=45
GLOBAL_STATE_CHANGES_ENABLED=false
LOG_LEVEL=INFO
DEMO_MODE=false
FIXTURE_MODE=false
E2E_MODE=false
DEMO_TARGET_URL=http://127.0.0.1:8021
DEMO_RESET_TOKEN=replace-with-a-random-demo-reset-token
CUSTOM_CA_PATH=
REPORT_STORAGE_PATH=../var/reports
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
